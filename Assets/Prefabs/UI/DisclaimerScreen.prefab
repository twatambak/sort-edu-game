  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Este jogo guarda as informa\xE7\xF5es das crian\xE7as (nome, idade e desempenho
    nas partidas) <b>somente neste aparelho</b>.\n\n\u2022 Os dados ficam armazenados
    apenas localmente, no pr\xF3prio dispositivo.\n\u2022 Nenhuma informa\xE7\xE3o
    \xE9 enviada pela internet, compartilhada com terceiros ou usada para publicidade
    ou qualquer outra finalidade.\n\u2022 Os dados servem exclusivamente para que
    pais, respons\xE1veis e professores acompanhem o progresso da crian\xE7a dentro
    do jogo.\n\u2022 Voc\xEA pode apagar os dados de cada crian\xE7a a qualquer momento
    na \xE1rea dos respons\xE1veis.\n\nAo continuar, voc\xEA confirma que \xE9 respons\xE1vel
    pela crian\xE7a ou tem autoriza\xE7\xE3o para cadastr\xE1-la."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b3436f98cc8696a4091db71112fffc39, type: 2}
